# Copy to .env for local development. Never commit .env.
# In production, set these in the Vercel and Render dashboards.

# ---------- backend ----------
APP_ENV=development                # development | production
# Local Postgres from docker-compose.yml listens on host port 5433.
# In production, paste Neon's pooled connection string; postgresql:// URLs are accepted as they are.
DATABASE_URL=postgresql+psycopg://wearwise:wearwise@localhost:5433/wearwise
# Optional. Migrations use this when set. In production, Neon's direct (non-pooled) connection string.
MIGRATION_DATABASE_URL=
# Tests drop and recreate this database on every run; its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://wearwise:wearwise@localhost:5433/wearwise_test
SESSION_SECRET=change-me           # long random string
SESSION_DAYS=30

# image storage: "local" in development, "s3" for Cloudflare R2 in production
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=8

# weather (M6): Open-Meteo needs no key
WEATHER_PROVIDER=open-meteo

# AI (M10): "fake" needs no key and is used in tests
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL_CHAT=
AI_MODEL_VISION=
AI_DAILY_SPEND_CAP_USD=1

# product sources (M9): comma-separated adapter names
PRODUCT_SOURCES=search_links,pasted_link

# email (password reset): "console" prints the link locally
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=

# ---------- frontend ----------
# Server-side only. Next.js proxies /api/* to this address.
BACKEND_URL=http://localhost:8000
# Anything starting with NEXT_PUBLIC_ is visible in the browser. No secrets here.
NEXT_PUBLIC_APP_NAME=WearWise
