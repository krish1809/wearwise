# Copy to .env for local development. Never commit .env.
# In production, set these in the Vercel and Render dashboards.

# ---------- backend ----------
APP_ENV=development                # development | production
# Local Postgres from docker-compose.yml listens on host port 5433.
# In production, paste Neon's pooled connection string; postgresql:// URLs are accepted as they are.
DATABASE_URL=postgresql+psycopg://wearwise:wearwise@localhost:5433/wearwise
# Optional. Migrations use this when set. In production, Neon's direct (non-pooled) connection string.
MIGRATION_DATABASE_URL=
# Tests drop and recreate this database on every run; its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://wearwise:wearwise@localhost:5433/wearwise_test
# A login lasts this many days and is extended while it's used. Session tokens are random
# and stored only as hashes, so no secret key is needed.
SESSION_DAYS=30

# Photo storage: "local" in development (a folder, relative to backend/), "s3" for a Backblaze
# B2 bucket in production, and "none" for the scheduled jobs, which never touch photos.
# Backblaze shows the endpoint as s3.<region>.backblazeb2.com; the region is the part in the
# middle, such as eu-central-003.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The largest upload the API accepts. The web app shrinks photos well below this first.
MAX_UPLOAD_MB=8

# weather (M6): "open-meteo" needs no key; "fake" gives a mild fortnight and one place (Pune),
# for working offline.
WEATHER_PROVIDER=open-meteo

# product pages (M9): "web" reads a link someone pastes (its preview data, obeying
# robots.txt); "fake" reads nothing, for working offline.
PAGE_READER=web

# AI (M10): the stylist chat and photo tagging. "off" shows them as unavailable; "anthropic"
# needs a key from console.anthropic.com and the model names and prices below (check the
# prices on the provider's pricing page; they turn token counts into the daily spend).
AI_PROVIDER=off
AI_API_KEY=
AI_MODEL_CHAT=claude-haiku-5-5
AI_MODEL_VISION=claude-haiku-5-5
AI_DAILY_SPEND_CAP_USD=1
AI_PRICE_INPUT_PER_MTOK=0.10
AI_PRICE_OUTPUT_PER_MTOK=0.50

# The owner's page of counts (/admin), for these accounts only; comma-separated (M11).
# Empty: nobody. Everyone else gets "not found".
ADMIN_EMAILS=

# product sources (M9): comma-separated adapter names
PRODUCT_SOURCES=search_links,pasted_link

# email (M12): the weekly digest, address confirmation, the owner's run reports, and password
# reset. "console" prints emails locally; "resend" needs a key from resend.com.
# Until a domain is verified with the provider, it sends only to its account owner's address:
# list that address in EMAIL_ALLOWLIST, and nothing goes anywhere else (comma-separated; empty
# means no limit, only once a domain is verified). EMAIL_DAILY_CAP stays under the provider's
# daily limit. EMAIL_LINK_SECRET signs unsubscribe and "not for me" links: a long random
# string, the same on Render and in GitHub's production environment.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_ALLOWLIST=
EMAIL_DAILY_CAP=90
EMAIL_LINK_SECRET=
# The site's address, for links in emails.
APP_URL=http://localhost:3000

# agents (M12). Web search for the Trend Scout: "off", "fake" (recorded results), or "tavily"
# (a key from tavily.com). Queries never carry personal data. The monthly cap counts the
# credits each search reports.
SEARCH_PROVIDER=off
SEARCH_API_KEY=
SEARCH_MONTHLY_CREDIT_CAP=600
# Limits on one Trend Scout run; when one is reached, it stops and keeps what is valid.
TREND_SCOUT_MAX_QUERIES=8
TREND_SCOUT_MAX_PAGES=40
TREND_SCOUT_MAX_TOKENS=200000
TREND_SCOUT_MAX_SECONDS=600
# New trends wait for the owner's approval on /admin before any digest uses them.
TRENDS_REQUIRE_APPROVAL=true
# The most digests one run sends; anyone left over is sent to by the next run.
DIGEST_BATCH_CAP=80
# Tracing of agent runs: "off" or "langsmith" (then also LANGSMITH_API_KEY). Never on in
# production for the stylist or the digest: their prompts carry wardrobe data.
AGENT_TRACING=off

# ---------- frontend ----------
# Server-side only. Next.js proxies /api/* to this address.
BACKEND_URL=http://localhost:8000
# Anything starting with NEXT_PUBLIC_ is visible in the browser. No secrets here.
NEXT_PUBLIC_APP_NAME=WearWise
