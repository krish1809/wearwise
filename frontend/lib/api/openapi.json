      },
      "BrandNoteOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "brand": {
            "type": "string",
            "title": "Brand"
          },
          "size_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Notes"
          },
          "quality_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality Notes"
          },
          "price_notes": {
            "anyOf": [
