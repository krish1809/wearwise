                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Notes"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "brand",
          "size_notes",
          "quality_notes",
          "price_notes",
          "updated_at"
        ],
        "title": "BrandNoteOut"
      },
      "BrandNoteUpdate": {
        "properties": {
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "size_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Notes"
          },
          "quality_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality Notes"
          },
          "price_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BrandNoteUpdate",
        "description": "Only the fields sent are changed. Null clears a note; the brand can't be cleared."
