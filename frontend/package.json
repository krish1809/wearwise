{
  "name": "wearwise-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript lib/api/openapi.json --output lib/api/schema.d.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.34.6"
}
